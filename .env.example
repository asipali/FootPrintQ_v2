# ==============================================================================
# FootprintIQ Python Application Configuration Template
# Copy this file to .env at the repository root and adjust values for your environment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application Metadata & Runtime Mode
APP_NAME="FootprintIQ - Digital Footprint Investigator"
APP_ENV="development"                  # Options: development, staging, production
DEBUG=True                             # Set to False in production
APP_VERSION="2.0.0"

# HTTP Server Binding
HOST="127.0.0.1"                       # Localhost by default; do not expose publicly without auth
PORT=8000

# Database Connection
# Microsoft SQL Server 2022 Express (Primary / Authoritative database):
# DATABASE_URL="mssql+pyodbc://localhost/footprintiq?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"
# SQLite (Local development / fallback database):
DATABASE_URL="sqlite:///./footprintiq.db"
# Fallback to SQLite if primary database is unreachable (development/test only; disabled in staging/prod):
DB_FALLBACK_TO_SQLITE=True
# PostgreSQL URL example:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/footprintiq"

# Security & Cryptography
# For development, a default fallback is permitted.
# For production, generate a 32+ character high-entropy key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-insecure-secret-key-change-in-production-only"

# Logging Configuration
LOG_LEVEL="INFO"                       # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="structured"                # Options: structured, standard

# Allowed Hosts for TrustedHostMiddleware
ALLOWED_HOSTS='["127.0.0.1", "localhost"]'

# ==============================================================================
# Authentication, Sessions & RBAC (Phase 3)
# ==============================================================================
SESSION_COOKIE_NAME="footprintiq_session"
SESSION_MAX_AGE_SECONDS=14400             # 4 hours
SESSION_COOKIE_SECURE=                    # Leave unset locally; staging/production defaults to Secure
SESSION_COOKIE_SAMESITE="lax"             # Options: lax, strict, none
CSRF_COOKIE_NAME="footprintiq_csrf"

# Account Security & Rate Limiting
MAX_FAILED_LOGIN_ATTEMPTS=5               # Max consecutive bad passwords before temporary lockout
LOCKOUT_DURATION_MINUTES=15               # Temporary account lockout duration
ALLOW_PUBLIC_SIGNUP=True                  # Allow self-service investigator registration

# Local demonstration accounts only. Production refuses this option.
DEFAULT_SIGNUP_ROLE="investigator"
DEMO_ACCOUNTS_ENABLED=False
DEMO_ADMIN_USERNAME="footprint_admin_demo"
DEMO_ADMIN_EMAIL="admin@footprint.org"
DEMO_ADMIN_PASSWORD=
DEMO_INVESTIGATOR_USERNAME="footprint_investigator_demo"
DEMO_INVESTIGATOR_EMAIL="investigator@footprint.org"
DEMO_INVESTIGATOR_PASSWORD=

# Initial Administrator Provisioning (Optional CLI env overrides)
# INITIAL_ADMIN_USERNAME="admin"
# INITIAL_ADMIN_EMAIL="admin@lab.example"
# INITIAL_ADMIN_PASSWORD="ReplaceWithSecure12+Chars!#"

# ==============================================================================
# Evidence Storage (Phase 4 & SeaweedFS Integration)
# ==============================================================================
# Storage Backend: 'seaweedfs' (production/authoritative) or 'filesystem' (local testing)
STORAGE_BACKEND="seaweedfs"
EVIDENCE_STORAGE_PATH="./evidence_storage"    # Forensic evidence storage root directory (filesystem adapter)
SEAWEEDFS_FILER_URL="http://localhost:18888"   # SeaweedFS Filer HTTP REST API endpoint
SEAWEEDFS_COLLECTION="evidence"               # SeaweedFS collection namespace for evidence objects
SEAWEEDFS_REPLICATION=""                      # SeaweedFS replication setting for new volumes (e.g. '001')
SEAWEEDFS_TIMEOUT_SECONDS=10.0                # SeaweedFS HTTP client timeout in seconds
SEAWEEDFS_MAX_RETRIES=3                       # Maximum bounded retry attempts for transient SeaweedFS HTTP failures
SEAWEEDFS_AUTH_TOKEN=""                       # Optional Bearer token for authenticated SeaweedFS Filer requests
SEAWEEDFS_FALLBACK_TO_FILESYSTEM=False        # Allow fallback to filesystem if SeaweedFS is unreachable (dev only)

# Passive Reconnaissance Collectors
RDAP_BOOTSTRAP_URL="https://rdap.org/domain"   # Public RDAP bootstrap directory
CRTSH_BASE_URL="https://crt.sh"               # Public Certificate Transparency API
THEHARVESTER_BIN=""                           # Path to theHarvester executable (leave empty if not installed)
RECON_TIMEOUT_SECONDS=15                      # Per-source network and subprocess execution timeout
RECON_MAX_CONCURRENCY=5                       # Bounded concurrency semaphore for parallel collectors

# ==============================================================================
# Active Reconnaissance & Nmap Execution (Phase 5)
# ==============================================================================
NMAP_BIN=""                                   # Path to Nmap binary (e.g., "E:/asipali/Nmap/nmap.exe" or "/usr/bin/nmap"). Auto-detected if empty.
NMAP_DEFAULT_TIMEOUT_SECONDS=120              # Execution timeout in seconds for active scan jobs
NMAP_MAX_CONCURRENCY=2                        # Maximum concurrent active Nmap scans permitted across application

# ==============================================================================
# Vulnerability Assessment & Greenbone/OpenVAS Integration (Phase 6)
# ==============================================================================
GVM_HOST=""                                   # Greenbone GMP daemon hostname or IP (e.g. "127.0.0.1" or "gvm.internal")
GVM_PORT=9390                                 # Greenbone GMP TLS port (default: 9390)
GVM_UNIX_SOCKET=""                            # Unix domain socket path (e.g. "/run/gvmd/gvmd.sock") on Linux/WSL
GVM_USERNAME=""                               # Greenbone GMP service or administrative username
GVM_PASSWORD=""                               # Greenbone GMP service password (never commit actual passwords)
GVM_TIMEOUT_SECONDS=180                       # Connection and network operation timeout in seconds
GVM_POLL_INTERVAL_SECONDS=5                   # Task monitoring polling interval in seconds
GVM_MAX_POLL_ATTEMPTS=60                      # Maximum polling cycles before timing out (5s * 60 = 5 minutes default)
GVM_TLS_VERIFY=True                           # Enforce TLS certificate validation when connecting over TLS
GVM_USE_TLS=False                              # Whether to use TLS for TCP connections (False for localhost bridge)
GVM_CA_FILE=""                                # Optional CA bundle for private Greenbone certificates
