# FootprintIQ Production Environment Configuration Template
APP_NAME="FootprintIQ - Digital Footprint Investigator"
APP_ENV="production"
DEBUG=False
APP_VERSION="2.0.0"

HOST="0.0.0.0"
PORT=8000
ALLOWED_HOSTS='["footprintiq.internal", "localhost"]'

DATABASE_URL="mssql+pyodbc://footprintiq_app:StrongPasswordHere@sqlserver.internal/footprintiq?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=no"
DB_FALLBACK_TO_SQLITE=False

SECRET_KEY="REPLACE_WITH_HIGH_ENTROPY_64_CHAR_HEX_KEY"

STORAGE_BACKEND="seaweedfs"
SEAWEEDFS_FILER_URL="http://seaweedfs-filer.internal:8888"
SEAWEEDFS_COLLECTION="evidence"
SEAWEEDFS_TIMEOUT_SECONDS=15.0
SEAWEEDFS_MAX_RETRIES=3
SEAWEEDFS_FALLBACK_TO_FILESYSTEM=False

SESSION_COOKIE_NAME="footprintiq_session"
SESSION_MAX_AGE_SECONDS=14400
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE="lax"
CSRF_COOKIE_NAME="footprintiq_csrf"

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ALLOW_PUBLIC_SIGNUP=False
DEMO_ACCOUNTS_ENABLED=False

